      exec("Mv([33,34,35,18,21,24,38,37,36,8,5,2],{})".format(s)),Rt.ACT()
  def B(s):
    for i in range(3):
      if i in (0,2):exec("Mv([45,46,47,50,53,52,51,48],{})".format(s))
      exec("Mv([27,0,3,6,42,43,44,26,23,20,29,28],{})".format(s)),Rt.ACT()
