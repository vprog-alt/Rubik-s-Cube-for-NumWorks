    for i in range(3):exec("Mv([12,13,14,21,22,23,48,49,50,3,4,5],{})".format(s)),Rt.ACT()
  def X(s):SVIT("Rt.U({}),Rt.E({}),Rt.D({})".format(not s,s,s))
  def Y(s):SVIT("Rt.L({}),Rt.M({}),Rt.R({})".format(not s,s,s))
  def Z(s):SVIT("Rt.F({}),Rt.S({}),Rt.B({})".format(s,s,not s))
  def prog(*M):
    for i in M:exec("Rt.{}({})".format(i[0],len(i)-1))

class CS:
  def C(c):rect(2,2,18,18,c)
  def solved():
    for i in range(0,45):
      if c[i]!=c[(i//9)*9]:return False
    return True
  def scramble():SVIT('for i in range(randint(18,30)):exec("Rt.{}({})".format(choice("LRUDFBMES"),randint(0,1)))')
  def reset():
    global c,scr
    c,scr=c_solved[:],False
    MN.ACT()
  def timer():
    global scr,chrono
    if key(4) and not scr:
      if not CS.solved():
        m=monotonic()
        CS.C((255,0,0))
        while key(4):
          if monotonic()-m>0.4:
            CS.C((0,255,0))
            scr=True
      chrono=monotonic()
    T="{:.3f}".format(monotonic()-chrono)
    if scr:
      CS.C((180,)*3),draw(T,318-10*len(T),0,white,bg)
      if CS.solved():
        CS.C((0,255,0)),draw(T,318-10*len(T),0,(0,255,0),bg)
        scr,chrono=False,0

