    for i in range(3):exec("Mv([10,34,31,28,46,49,52,43,40,37,16,13],{})".format(s)),Rt.ACT()
  def S(s):
    for i in range(3):exec("Mv([30,31,32,19,22,25,41,40,39,7,4,1],{})".format(s)),Rt.ACT()
